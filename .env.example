# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for this applet.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Primary high-speed model provider (Optional, falls back to OpenRouter/Gemini if absent).
GROQ_API_KEY=""

# OPENROUTER_API_KEY: Secondary fallback model provider (Optional).
OPENROUTER_API_KEY=""

# BACKBLAZE B2 CREDENTIALS (For Vault cloud storage, optional with local IndexedDB fallback)
B2_APPLICATION_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ENDPOINT="s3.us-west-000.backblazeb2.com"
